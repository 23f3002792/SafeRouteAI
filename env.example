# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development           # development | production
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL / PostGIS database (for future spatial queries)
DATABASE_URL=postgresql://user:pass@localhost:5432/saferoute

# ── Redis (score cache + rate-limit counters) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=1800

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to your downloaded service account JSON key.
FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/serviceAccountKey.json

# ── OSRM routing engine ───────────────────────────────────────────────────────
# Base routing (shortest path) used before safety scoring
OSRM_BASE_URL=http://localhost:5000

ORS_API_KEY=your_free_key_from_openrouteservice.org
# Get key at: https://openrouteservice.org/dev/#/signup (free, instant)

# ── City bounding box (min_lon,min_lat,max_lon,max_lat) ───────────────────────
# Default: Hyderabad, Telangana, India
CITY_BBOX=78.2000,17.2000,78.7000,17.6000

# ── AI / Weather ──────────────────────────────────────────────────────────────
# OpenWeatherMap API key (required for weather-based scoring)
# If not set, weather defaults to safe (1.0)
OWM_API_KEY=your_openweathermap_api_key_here

# ── Production only ───────────────────────────────────────────────────────────
# Allowed origin for CORS when FLASK_ENV=production
FRONTEND_ORIGIN=https://saferoute.ai